# Copy to game/.env.local, fill locally, then restart npm run dev.
# Server-only: do not rename these variables with the VITE_ prefix.
AI_API_KEY=
AI_BASE_URL=https://vibetoken.cn/v1
# On Vercel, create these three variables in Project Settings instead.
# Use an exact text/chat model ID available to your redeemed account.
AI_MODEL=deepseek/deepseek-v4.1-flash-1017
